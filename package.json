{
	"name": "handwriting",
	"version": "1.4.8",
	"description": "Handwrite, highlight, erase and lasso on your notes and PDFs. Your notes stay Markdown.",
	"main": "main.js",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit && node esbuild.config.mjs production",
		"test": "vitest run",
		"probe": "node scripts/webkit-probe.mjs",
		"release": "node scripts/release.mjs",
		"check:versions": "node scripts/check-versions.mjs",
		"check:site": "node scripts/check-site.mjs"
	},
	"keywords": [],
	"author": "Alan",
	"license": "CC-BY-NC-ND-4.0",
	"devDependencies": {
		"@codemirror/commands": "^6.6.0",
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"esbuild": "^0.28.2",
		"obsidian": "^1.13.1",
		"playwright": "^1.62.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"overrides": {
		"@codemirror/state": "6.5.0"
	}
}
